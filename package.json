{
  "name": "pi-bareplan",
  "version": "0.1.10",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "test": "node selfcheck.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format ."
  },
  "description": "Pi extension that starts every session in plan mode: read-only investigation, then a proposal before any file changes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fn-cafeina/pi-bareplan.git"
  },
  "homepage": "https://github.com/fn-cafeina/pi-bareplan#readme",
  "bugs": {
    "url": "https://github.com/fn-cafeina/pi-bareplan/issues"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "exports": "./index.ts",
  "files": [
    "index.ts"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
